{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Boring, weekly-only Renovate config for this repo.",
    "Watches: GitHub Actions, the helmfile's chart pins, src/ansible/requirements.txt, specs/package.json, and through the customManagers every other pin: image: lines under src/kubernetes/services/, the busybox digest, k3s / helm / helmfile / helm-diff (group_vars/all/versions.yml), helm-unittest and the docs toolchain (Makefile), k3d and the k8s client library (upgrade-test.yaml), and the Ansible collections' git tags.",
    "Every pin has one home; CI reads it from there rather than holding a copy.",
    "Not watched: kubeconform and gitleaks (a SHA256 pin Renovate cannot recompute); Debian and Tailscale move through unattended-upgrades.",
    "Automerge is disabled everywhere: every update lands as a PR for manual review."
  ],
  "extends": [
    "config:recommended",
    "schedule:weekly"
  ],
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bare image pins in platform-service and app-chart values files.",
      "managerFilePatterns": [
        "/^src/kubernetes/services/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s+(?<depName>[a-z0-9][a-z0-9./-]*):(?<currentValue>[A-Za-z0-9][A-Za-z0-9._-]*)(?:\\s|$)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "k3s, pinned in group_vars/all/versions.yml.",
      "managerFilePatterns": [
        "/^src/ansible/inventories/group_vars/all/versions\\.yml$/"
      ],
      "matchStrings": [
        "k3s_version:\\s+\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "helm, pinned in group_vars/all/versions.yml (validate.yaml reads it from there).",
      "managerFilePatterns": [
        "/^src/ansible/inventories/group_vars/all/versions\\.yml$/"
      ],
      "matchStrings": [
        "helm_version:\\s+\"(?<currentValue>v[^\"]+)\""
      ],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "helmfile, pinned in group_vars/all/versions.yml (validate.yaml reads it from there).",
      "managerFilePatterns": [
        "/^src/ansible/inventories/group_vars/all/versions\\.yml$/"
      ],
      "matchStrings": [
        "helmfile_version:\\s+\"(?<currentValue>v[^\"]+)\""
      ],
      "depNameTemplate": "helmfile/helmfile",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "helm-diff, pinned in group_vars/all/versions.yml.",
      "managerFilePatterns": [
        "/^src/ansible/inventories/group_vars/all/versions\\.yml$/"
      ],
      "matchStrings": [
        "helm_diff_version:\\s+\"(?<currentValue>v[^\"]+)\""
      ],
      "depNameTemplate": "databus23/helm-diff",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "helm-unittest, pinned in the Makefile (validate.yaml reads it from there).",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "HELM_UNITTEST_VERSION := (?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "helm-unittest/helm-unittest",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Ansible collections, installed from their GitHub tags (src/ansible/requirements.yml says why).",
      "managerFilePatterns": [
        "/^src/ansible/requirements\\.yml$/"
      ],
      "matchStrings": [
        "name: https://github\\.com/(?<depName>[^/\\s]+/[^\\s]+?)\\.git\\n\\s+type: git\\n\\s+version: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "The busybox init image, pinned by digest in the app chart, two values files and the chart's snapshot: one PR moves every copy.",
      "managerFilePatterns": [
        "/^src/kubernetes/.+\\.(ya?ml|snap)$/"
      ],
      "matchStrings": [
        "(?<depName>busybox):(?<currentValue>[0-9][0-9.]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "k3d, the upgrade test's throwaway cluster.",
      "managerFilePatterns": [
        "/^\\.github/workflows/upgrade-test\\.yaml$/"
      ],
      "matchStrings": [
        "K3D_VERSION=(?<currentValue>v[0-9.]+)"
      ],
      "depNameTemplate": "k3d-io/k3d",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "The k8s client library the upgrade test installs beside Ansible.",
      "managerFilePatterns": [
        "/^\\.github/workflows/upgrade-test\\.yaml$/"
      ],
      "matchStrings": [
        "kubernetes==(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "kubernetes",
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "The toolchain make check-docs runs.",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "@jterrazz/typescript@(?<currentValue>[0-9.]+)"
      ],
      "depNameTemplate": "@jterrazz/typescript",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "groupName": "github actions"
    },
    {
      "description": "ClickHouse stays on the 26.3 LTS line: 26.5 and 26.7 break OpenPanel (op-clickhouse.yaml).",
      "matchPackageNames": [
        "clickhouse/clickhouse-server"
      ],
      "allowedVersions": "/^26\\.3\\./"
    },
    {
      "description": "PostgreSQL 18 changes the image's data layout; a major is a dump/restore (docs/guides/operate.md).",
      "matchPackageNames": [
        "postgres"
      ],
      "enabled": false
    },
    {
      "description": "Redis 8: no support statement from OpenPanel or BullMQ (docs/guides/operate.md, Version decisions).",
      "matchPackageNames": [
        "redis"
      ],
      "allowedVersions": "<8"
    },
    {
      "description": "external-dns 0.22 and 0.23 generate no endpoint from a traefik.io IngressRoute (2026-10-25); lift once a release does, proved with --dry-run against the live routes.",
      "matchPackageNames": [
        "external-dns"
      ],
      "allowedVersions": "<1.22.0"
    }
  ]
}
