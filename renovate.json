{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Boring, weekly-only Renovate config for this repo.",
    "Watches: GitHub Actions versions in .github/workflows/, the Helm chart pins in kubernetes/helmfile.yaml.gotmpl (native helmfile manager), and, through the customManagers below, every other hand-held pin: bare `image:` lines in kubernetes/services/ (app-chart values the native managers never parse), k3s / helm / helmfile / helm-diff / helm-unittest, ansible-core and ansible-lint, and the Ansible collections' git tags.",
    "A hand-synced pair (docs/reference/hand-synced-pairs.md) shares one depName, so both copies move in the same PR.",
    "Not watched: kubeconform and gitleaks (their SHA256 pins cannot be bumped by Renovate), the busybox digest (held in sync by scripts/assert-sync.py), Debian and Tailscale (unattended-upgrades and apt).",
    "Automerge is disabled everywhere: every update lands as a PR for manual review."
  ],
  "extends": [
    "config:recommended",
    "schedule:weekly"
  ],
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Bare image pins in platform-service and app-chart values files.",
      "managerFilePatterns": [
        "/^kubernetes/services/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "image:\\s+(?<depName>[a-z0-9][a-z0-9./-]*):(?<currentValue>[A-Za-z0-9][A-Za-z0-9._-]*)(?:\\s|$)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "k3s, pinned in group_vars.",
      "managerFilePatterns": [
        "/^ansible/inventories/group_vars/all\\.yml$/"
      ],
      "matchStrings": [
        "k3s_version:\\s+\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "helm: group_vars and the azure/setup-helm input in validate.yaml (a hand-synced pair).",
      "managerFilePatterns": [
        "/^ansible/inventories/group_vars/all\\.yml$/",
        "/^\\.github/workflows/validate\\.yaml$/"
      ],
      "matchStrings": [
        "helm_version:\\s+\"(?<currentValue>v[^\"]+)\"",
        "uses: azure/setup-helm@\\S+.*\\n\\s+with:\\n\\s+version: (?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "helmfile: group_vars and HELMFILE_VERSION in validate.yaml (a hand-synced pair).",
      "managerFilePatterns": [
        "/^ansible/inventories/group_vars/all\\.yml$/",
        "/^\\.github/workflows/validate\\.yaml$/"
      ],
      "matchStrings": [
        "helmfile_version:\\s+\"(?<currentValue>v[^\"]+)\"",
        "HELMFILE_VERSION=(?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "helmfile/helmfile",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "helm-diff, pinned in group_vars.",
      "managerFilePatterns": [
        "/^ansible/inventories/group_vars/all\\.yml$/"
      ],
      "matchStrings": [
        "helm_diff_version:\\s+\"(?<currentValue>v[^\"]+)\""
      ],
      "depNameTemplate": "databus23/helm-diff",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "helm-unittest, installed by validate.yaml.",
      "managerFilePatterns": [
        "/^\\.github/workflows/validate\\.yaml$/"
      ],
      "matchStrings": [
        "HELM_UNITTEST_VERSION=(?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "helm-unittest/helm-unittest",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "ansible-core and ansible-lint pip pins in both workflows (ansible-core is a hand-synced pair).",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>ansible-core|ansible-lint)==(?<currentValue>[0-9][0-9.]*)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Ansible collections, installed from their GitHub tags (ansible/requirements.yml says why).",
      "managerFilePatterns": [
        "/^ansible/requirements\\.yml$/"
      ],
      "matchStrings": [
        "name: https://github\\.com/(?<depName>[^/\\s]+/[^\\s]+?)\\.git\\n\\s+type: git\\n\\s+version: \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/**"
      ],
      "groupName": "github actions"
    },
    {
      "description": "ClickHouse stays on the 26.3 LTS line: 26.5 and 26.7 break OpenPanel (op-clickhouse.yaml).",
      "matchPackageNames": [
        "clickhouse/clickhouse-server"
      ],
      "allowedVersions": "/^26\\.3\\./"
    },
    {
      "description": "PostgreSQL 18 changes the image's data layout; a major is a dump/restore (docs/guides/operate.md).",
      "matchPackageNames": [
        "postgres"
      ],
      "enabled": false
    },
    {
      "description": "Redis 8: no support statement from OpenPanel or BullMQ (docs/guides/operate.md, Version decisions).",
      "matchPackageNames": [
        "redis"
      ],
      "allowedVersions": "<8"
    }
  ]
}
