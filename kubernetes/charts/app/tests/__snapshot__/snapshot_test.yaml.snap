  3: |
    apiVersion: v1
    data:
      ci-test-app-overview.json: |
        { "title": "ci-test-app overview", "panels": [] }
    kind: ConfigMap
    metadata:
      annotations:
        grafana_folder: ci-test-app
      labels:
        app: ci-test-app
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
