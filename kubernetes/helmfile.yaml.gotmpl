# invariant: every platform release, declared once with its pinned chart version;
# nothing else lists releases. Paths are relative to this file (the node receives
# only kubernetes/). A new service: docs/guides/operate.md#add-a-new-platform-service.
# hazard: a release's name and namespace are the identity of live data: renaming
# either orphans the hostPath PV it bound; docs/decisions/009-one-helmfile-declares-every-platform-release.md

repositories:
  - name: jetstack
    url: https://charts.jetstack.io
  - name: infisical
    url: https://dl.cloudsmith.io/public/infisical/helm-charts/helm/charts/
  - name: grafana-community
    url: https://grafana-community.github.io/helm-charts
  - name: vm
    url: https://victoriametrics.github.io/helm-charts/
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: open-telemetry
    url: https://open-telemetry.github.io/opentelemetry-helm-charts

helmDefaults:
  # invariant: true in every real deploy; the upgrade test sets PLATFORM_HELM_WAIT=false
  # and judges with `helm list --failed`; docs/decisions/021-the-deploy-is-tested-on-a-throwaway-k3d-cluster.md
  wait: {{ env "PLATFORM_HELM_WAIT" | default "true" }}
  timeout: 300
  # hazard: namespaces carry Pod Security labels (cluster/namespaces.yaml); helm's
  # `--create-namespace` would create an unlabelled one first.
  createNamespace: false

templates:
  # hazard: the `<name>-platform` releases install before the chart that mounts their
  # volume, and their suffix is frozen: a renamed release orphans its hostPath PV.
  platform-service:
    chart: ./charts/platform-service
    timeout: 120
    needs:
      - platform-networking/cert-manager
    labels:
      tier: platform
    values:
      # invariant: the PV's nodeAffinity target, supplied by the caller (Ansible, the
      # Makefile) so this file names no machine.
      - infrastructure:
          nodeName: {{ requiredEnv "NODE_NAME" | quote }}

releases:
  # --- bootstrap ------------------------------------------------------------
  # invariant: `tier: bootstrap` is applied first: later passes need the InfisicalSecret
  # and Certificate CRDs.
  - name: cert-manager
    namespace: platform-networking
    chart: jetstack/cert-manager
    version: v1.21.3
    wait: true
    labels:
      tier: bootstrap
    values:
      - services/cert-manager/values.yaml

  - name: infisical
    namespace: platform-secrets
    chart: infisical/secrets-operator
    version: 0.11.9
    wait: true
    labels:
      tier: bootstrap
    values:
      - services/infisical/values.yaml

  # --- telemetry ------------------------------------------------------------
  - name: grafana-platform
    namespace: platform-telemetry
    inherit:
      - template: platform-service
    values:
      - services/grafana/service.yaml

  - name: victoria-metrics-platform
    namespace: platform-telemetry
    inherit:
      - template: platform-service
    values:
      - services/victoria-metrics/service.yaml

  - name: victoria-logs-platform
    namespace: platform-telemetry
    inherit:
      - template: platform-service
    values:
      - services/victoria-logs/service.yaml

  - name: victoria-traces-platform
    namespace: platform-telemetry
    inherit:
      - template: platform-service
    values:
      - services/victoria-traces/service.yaml

  - name: victoria-metrics
    namespace: platform-telemetry
    chart: vm/victoria-metrics-single
    version: 0.46.0
    needs:
      - platform-telemetry/victoria-metrics-platform
    values:
      - services/victoria-metrics/values.yaml

  - name: victoria-logs
    namespace: platform-telemetry
    chart: vm/victoria-logs-single
    version: 0.13.9
    needs:
      - platform-telemetry/victoria-logs-platform
    values:
      - services/victoria-logs/values.yaml

  # hazard: pre-1.0 knowingly (victoria-traces/values.yaml); not a licence for the 1.x pins.
  - name: victoria-traces
    namespace: platform-telemetry
    chart: vm/victoria-traces-single
    version: 0.1.11
    needs:
      - platform-telemetry/victoria-traces-platform
    values:
      - services/victoria-traces/values.yaml

  - name: kube-state-metrics
    namespace: platform-telemetry
    chart: prometheus-community/kube-state-metrics
    version: 8.5.0
    values:
      - services/kube-state-metrics/values.yaml

  # invariant: the release is `node-exporter`, hence the fullnameOverride in its values.
  - name: node-exporter
    namespace: platform-telemetry
    chart: prometheus-community/prometheus-node-exporter
    version: 4.57.0
    values:
      - services/node-exporter/values.yaml

  - name: otel-collector-platform
    namespace: platform-telemetry
    inherit:
      - template: platform-service
    values:
      - services/otel-collector/service.yaml

  # invariant: after VictoriaLogs, Metrics and Traces: the collector writes to all three.
  - name: otel-collector
    namespace: platform-telemetry
    chart: open-telemetry/opentelemetry-collector
    version: 0.173.1
    needs:
      - platform-telemetry/otel-collector-platform
      - platform-telemetry/victoria-logs
      - platform-telemetry/victoria-metrics
      - platform-telemetry/victoria-traces
    values:
      - services/otel-collector/values.yaml

  # hazard: grafana.db migrates on first boot, irreversibly; rollback is a data restore.
  - name: grafana
    namespace: platform-telemetry
    chart: grafana-community/grafana
    version: 13.7.0
    needs:
      - platform-telemetry/grafana-platform
    values:
      - services/grafana/values.yaml
      # hazard: inline, never `--set`: argv is readable from `ps`.
      - adminPassword: {{ requiredEnv "GRAFANA_ADMIN_PASSWORD" | quote }}

  # --- networking -----------------------------------------------------------
  # invariant: the tunnel token only; the Deployment stays a raw manifest (hostNetwork).
  - name: cloudflared-platform
    namespace: platform-networking
    inherit:
      - template: platform-service
    values:
      - services/cloudflared/service.yaml

  # --- OpenPanel ------------------------------------------------------------
  # invariant: no upstream chart: six app-chart releases; the three applications load
  # services/openpanel/config.yaml first. This release owns their storage and certs;
  # docs/decisions/010-every-workload-renders-through-two-charts.md
  - name: openpanel-platform
    namespace: platform-analytics
    inherit:
      - template: platform-service
    values:
      - services/openpanel/service.yaml

  - name: op-postgres
    namespace: platform-analytics
    chart: ./charts/app
    needs:
      - platform-analytics/openpanel-platform
    values:
      - services/openpanel/op-postgres.yaml

  - name: op-redis
    namespace: platform-analytics
    chart: ./charts/app
    needs:
      - platform-analytics/openpanel-platform
    values:
      - services/openpanel/op-redis.yaml

  - name: op-clickhouse
    namespace: platform-analytics
    chart: ./charts/app
    needs:
      - platform-analytics/openpanel-platform
    values:
      - services/openpanel/op-clickhouse.yaml

  # value: 10m, not 5m: a first-boot migration is slow (its startupProbe allows 300s).
  - name: op-api
    namespace: platform-analytics
    chart: ./charts/app
    timeout: 600
    needs:
      - platform-analytics/op-postgres
      - platform-analytics/op-redis
      - platform-analytics/op-clickhouse
    values:
      - services/openpanel/config.yaml
      - services/openpanel/op-api.yaml

  - name: op-worker
    namespace: platform-analytics
    chart: ./charts/app
    needs:
      - platform-analytics/op-api
    values:
      - services/openpanel/config.yaml
      - services/openpanel/op-worker.yaml

  - name: op-dashboard
    namespace: platform-analytics
    chart: ./charts/app
    needs:
      - platform-analytics/op-api
    values:
      - services/openpanel/config.yaml
      - services/openpanel/op-dashboard.yaml

  # --- registry -------------------------------------------------------------
  - name: registry-platform
    namespace: platform-registry
    inherit:
      - template: platform-service
    values:
      - services/registry/service.yaml

  # invariant: every image and the app chart live here; publish-app-chart.yml pushes
  # to it right after this pass.
  - name: registry
    namespace: platform-registry
    chart: ./charts/app
    needs:
      - platform-registry/registry-platform
    values:
      - services/registry/app.yaml
