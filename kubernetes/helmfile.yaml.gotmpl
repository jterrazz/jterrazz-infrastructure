# Every platform Helm release, declared once: name, namespace, chart, pinned
# version and values file. Nothing else in this repo lists releases or chart
# versions — not Ansible, not a preview script, not Renovate.
#
# Applied ON THE NODE by ansible/roles/platform (which stages this whole
# kubernetes/ tree to /tmp/k8s-manifests), and read-only from the Mac by
# `make diff`. Every path below is relative to THIS file, which is why it lives
# in kubernetes/ rather than at the repo root — the node only ever receives
# this subtree.
#
# ADDING A SERVICE: one release block here, one values file beside it, a
# namespace in cluster/namespaces.yaml and a NetworkPolicy. See
# docs/RUNBOOK.md#add-a-new-platform-service.
#
# THE RELEASE NAME AND NAMESPACE ARE THE IDENTITY OF LIVE DATA. Renaming either
# creates a NEW release and orphans the hostPath PV the old one bound — see
# "Immutable fields" in CLAUDE.md.

repositories:
  - name: jetstack
    url: https://charts.jetstack.io
  - name: infisical
    url: https://dl.cloudsmith.io/public/infisical/helm-charts/helm/charts/
  # Grafana's OSS charts live here, renumbered; sole consumer is `grafana`. The
  # OLD `grafana` repo is deliberately absent — nothing pulls from it.
  - name: grafana-community
    url: https://grafana-community.github.io/helm-charts
  # The whole VictoriaMetrics family — victoria-metrics-single,
  # victoria-logs-single, victoria-traces-single.
  - name: vm
    url: https://victoriametrics.github.io/helm-charts/
  # kube-state-metrics and prometheus-node-exporter, each its own release —
  # both dashboards depend on the series they produce.
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: open-telemetry
    url: https://open-telemetry.github.io/opentelemetry-helm-charts
  # OCI rather than a chart index. Declared as a repository (not an inline
  # `oci://` chart ref) so Renovate's helmfile manager resolves it through the
  # docker datasource.
  - name: librechat
    url: ghcr.io/danny-avila/librechat-chart
    oci: true

helmDefaults:
  wait: true
  timeout: 300
  # Namespaces are declared in cluster/namespaces.yaml with their Pod Security
  # Admission labels; helm's own `--create-namespace` (helmfile's default)
  # would create an unlabelled one first and win the race.
  createNamespace: false

# `inherit:` rather than a YAML anchor — helmfile 1.x dropped anchor support in
# the state file.
templates:
  # The `<name>-platform` releases: Certificate + IngressRoute + hostPath
  # PV/PVCs for a service, from one values file. Always installed BEFORE the
  # upstream chart that mounts the volume — `helm --wait` otherwise blocks on a
  # pod that cannot schedule for want of a PVC.
  #
  # THE `-platform` SUFFIX IS FROZEN: the chart is `platform-service`, but a
  # renamed RELEASE is a new release and orphans the hostPath PV the old one
  # bound. Never rename these to match the chart.
  platform-service:
    chart: ./charts/platform-service
    # 2m is enough for PV/PVC binding and a Certificate; there is no pod here.
    timeout: 120
    needs:
      - platform-networking/cert-manager
    labels:
      tier: platform
    values:
      # The one value no values file can hold: the hostPath PV's nodeAffinity
      # target. The caller supplies it (Ansible passes inventory_hostname, the
      # Makefile the VM name) so this file names no machine.
      - infrastructure:
          nodeName: {{ requiredEnv "NODE_NAME" | quote }}

releases:
  # --- bootstrap ------------------------------------------------------------
  # `tier: bootstrap` is applied on its own, first: the Infisical operator must
  # provide the InfisicalSecret CRD, and cert-manager the Certificate one,
  # before roles/platform applies either kind. Everything else follows in the
  # unselected pass.
  - name: cert-manager
    namespace: platform-networking
    chart: jetstack/cert-manager
    version: v1.21.0
    labels:
      tier: bootstrap
    values:
      - services/cert-manager/values.yaml

  - name: infisical
    namespace: platform-secrets
    chart: infisical/secrets-operator
    version: 0.11.5
    labels:
      tier: bootstrap
    values:
      - services/infisical/values.yaml

  # --- telemetry ------------------------------------------------------------
  - name: grafana-platform
    namespace: platform-telemetry
    inherit:
      - template: platform-service
    values:
      - services/grafana/service.yaml

  - name: victoria-metrics-platform
    namespace: platform-telemetry
    inherit:
      - template: platform-service
    values:
      - services/victoria-metrics/service.yaml

  - name: victoria-logs-platform
    namespace: platform-telemetry
    inherit:
      - template: platform-service
    values:
      - services/victoria-logs/service.yaml

  - name: victoria-traces-platform
    namespace: platform-telemetry
    inherit:
      - template: platform-service
    values:
      - services/victoria-traces/service.yaml

  # Chart minors move fast; read the app version each one ships.
  - name: victoria-metrics
    namespace: platform-telemetry
    chart: vm/victoria-metrics-single
    version: 0.43.0
    needs:
      - platform-telemetry/victoria-metrics-platform
    values:
      - services/victoria-metrics/values.yaml

  - name: victoria-logs
    namespace: platform-telemetry
    chart: vm/victoria-logs-single
    version: 0.13.9
    needs:
      - platform-telemetry/victoria-logs-platform
    values:
      - services/victoria-logs/values.yaml

  # PRE-1.0, KNOWINGLY — see the boxed note in victoria-traces/values.yaml. Do
  # NOT extend that tolerance to the two 1.x pins above.
  - name: victoria-traces
    namespace: platform-telemetry
    chart: vm/victoria-traces-single
    version: 0.1.10
    needs:
      - platform-telemetry/victoria-traces-platform
    values:
      - services/victoria-traces/values.yaml

  - name: kube-state-metrics
    namespace: platform-telemetry
    chart: prometheus-community/kube-state-metrics
    version: 8.0.0
    values:
      - services/kube-state-metrics/values.yaml

  # The CHART is `prometheus-node-exporter`; the RELEASE is `node-exporter`
  # (hence the fullnameOverride in its values.yaml).
  - name: node-exporter
    namespace: platform-telemetry
    chart: prometheus-community/prometheus-node-exporter
    version: 4.56.1
    values:
      - services/node-exporter/values.yaml

  # The collector's Langfuse credentials and its OTLP-ingest NetworkPolicy. No
  # host, no storage — a `-platform` release can be just the things that must
  # exist BEFORE the workload does.
  - name: otel-collector-platform
    namespace: platform-telemetry
    inherit:
      - template: platform-service
    values:
      - services/otel-collector/service.yaml

  # AFTER VictoriaLogs: the collector owns pod-log shipping (its filelog
  # receiver), so an earlier install has nowhere to write. It also exports to
  # VictoriaMetrics and VictoriaTraces.
  - name: otel-collector
    namespace: platform-telemetry
    chart: open-telemetry/opentelemetry-collector
    version: 0.165.0
    needs:
      - platform-telemetry/otel-collector-platform
      - platform-telemetry/victoria-logs
      - platform-telemetry/victoria-metrics
      - platform-telemetry/victoria-traces
    values:
      - services/otel-collector/values.yaml

  # grafana-community repo. grafana.db migrates itself on first boot and is NOT
  # reversible, so the rollback is the /var/lib/k8s-data/grafana restore.
  - name: grafana
    namespace: platform-telemetry
    chart: grafana-community/grafana
    version: 12.8.0
    needs:
      - platform-telemetry/grafana-platform
    values:
      - services/grafana/values.yaml
      # An inline values map, not `--set`: `--set` puts the password in the
      # helm process' argv, where any user on the box can read it off `ps`.
      - adminPassword: {{ requiredEnv "GRAFANA_ADMIN_PASSWORD" | quote }}

  # --- networking -----------------------------------------------------------
  # cloudflared's tunnel token. The Deployment itself stays a raw manifest
  # (`hostNetwork: true`, applied by roles/platform/tasks/raw-manifests.yml) —
  # it is the one workload the app chart deliberately does not own.
  - name: cloudflared-platform
    namespace: platform-networking
    inherit:
      - template: platform-service
    values:
      - services/cloudflared/service.yaml

  # --- LibreChat ------------------------------------------------------------
  - name: librechat-platform
    namespace: platform-ai
    inherit:
      - template: platform-service
    values:
      - services/librechat/service.yaml

  # The standalone MongoDB, in place of the chart's bundled Bitnami subchart.
  # An app-chart release like any workload: it mounts the PVC its `-platform`
  # sibling creates, and LibreChat will not pass readiness without it.
  - name: librechat-mongodb
    namespace: platform-ai
    chart: ./charts/app
    needs:
      - platform-ai/librechat-platform
    values:
      - services/librechat/mongodb.yaml

  # Bump together with the image tag pinned in librechat/values.yaml.
  - name: librechat
    namespace: platform-ai
    chart: librechat/librechat
    version: 2.0.7
    needs:
      - platform-ai/librechat-mongodb
    values:
      - services/librechat/values.yaml

  # --- OpenPanel ------------------------------------------------------------
  # No upstream chart: six app-chart releases, one values file each, plus the
  # shared non-secret env in services/openpanel/config.yaml (which the three
  # APPLICATION releases load first — helm merges the two files).
  #
  # This release is their storage and the two certificates their routes name:
  # op-api and op-dashboard both answer on openpanel.internal.jterrazz.com, so
  # neither can own that hostname's certificate.
  - name: openpanel-platform
    namespace: platform-analytics
    inherit:
      - template: platform-service
    values:
      - services/openpanel/service.yaml

  # The three datastores. Each mounts a claim openpanel-platform owns and is
  # `isolated:` — reachable only from this namespace, dialling nothing but DNS.
  - name: op-postgres
    namespace: platform-analytics
    chart: ./charts/app
    needs:
      - platform-analytics/openpanel-platform
    values:
      - services/openpanel/op-postgres.yaml

  - name: op-redis
    namespace: platform-analytics
    chart: ./charts/app
    needs:
      - platform-analytics/openpanel-platform
    values:
      - services/openpanel/op-redis.yaml

  - name: op-clickhouse
    namespace: platform-analytics
    chart: ./charts/app
    needs:
      - platform-analytics/openpanel-platform
    values:
      - services/openpanel/op-clickhouse.yaml

  # op-api owns the schema — it runs `migrate:deploy` on boot — so it installs
  # after the datastores and before the two releases that read what it wrote.
  # 10m rather than the 5m default: a first-boot migration is the slow case,
  # and its startupProbe alone allows 300s.
  - name: op-api
    namespace: platform-analytics
    chart: ./charts/app
    timeout: 600
    needs:
      - platform-analytics/op-postgres
      - platform-analytics/op-redis
      - platform-analytics/op-clickhouse
    values:
      - services/openpanel/config.yaml
      - services/openpanel/op-api.yaml

  - name: op-worker
    namespace: platform-analytics
    chart: ./charts/app
    needs:
      - platform-analytics/op-api
    values:
      - services/openpanel/config.yaml
      - services/openpanel/op-worker.yaml

  - name: op-dashboard
    namespace: platform-analytics
    chart: ./charts/app
    needs:
      - platform-analytics/op-api
    values:
      - services/openpanel/config.yaml
      - services/openpanel/op-dashboard.yaml

  # --- registry -------------------------------------------------------------
  # The Certificate, the IngressRoute and the blob volume; the workload itself
  # is the `registry` release below.
  - name: registry-platform
    namespace: platform-registry
    inherit:
      - template: platform-service
    values:
      - services/registry/service.yaml

  # Every app image and the app chart itself live here, so this release is on
  # the critical path of every deploy — including publish-app-chart.yml, which
  # runs after this pass and pushes to it.
  - name: registry
    namespace: platform-registry
    chart: ./charts/app
    needs:
      - platform-registry/registry-platform
    values:
      - services/registry/app.yaml
