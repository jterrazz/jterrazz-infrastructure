    {
      "type": "table",
      "title": "Server errors by path",
      "description": "Routes that answered 5xx over the range, by app, ids folded into :id. From Traefik's access lines.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "expr": "{k8s.namespace.name=\"kube-system\"} KubernetesIngressRouteNamespace:~\"${namespace:regex}\" | replace_regexp (\"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\", \":id\") at RequestPath | filter DownstreamStatus:>=500 | stats by (KubernetesIngressRouteNamespace, RequestPath, DownstreamStatus) count() requests",
          "queryType": "stats",
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "valueLabel": "__name__"
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "KubernetesIngressRouteNamespace": 0,
              "RequestPath": 1,
              "DownstreamStatus": 2,
              "requests": 3
            },
            "renameByName": {
              "KubernetesIngressRouteNamespace": "app",
              "RequestPath": "path",
              "DownstreamStatus": "status",
              "_msg": "message",
              "src": "source"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "requests",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No server error",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
