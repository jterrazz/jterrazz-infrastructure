// Managed by Ansible (security role).
//
// These origin patterns MUST stay Debian-shaped. The Ubuntu-style
// "${distro_id}:${distro_codename}-security" matches NOTHING here — Debian's
// security archive publishes as Origin=Debian, Label=Debian-Security. With the
// Ubuntu pattern unattended-upgrades finds zero allowed origins and exits
// successfully having installed nothing, so patching stops SILENTLY. Verify:
//   unattended-upgrade --dry-run --debug
Unattended-Upgrade::Origins-Pattern {
    "origin=Debian,codename=${distro_codename},label=Debian";
    "origin=Debian,codename=${distro_codename}-security,label=Debian-Security";
    "origin=Debian,codename=${distro_codename}-updates,label=Debian";
};

Unattended-Upgrade::Package-Blacklist {
};

Unattended-Upgrade::DevRelease "false";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
// Spelled out, not left to the package default: an unattended reboot on a
// single-node cluster is an unattended outage.
Unattended-Upgrade::Automatic-Reboot "false";
