#!/usr/bin/env bash
# Managed by Ansible (tailscale role). THE definition of "log this node into
# the tailnet", run both by tailscale-autoauth.service on every boot and by the
# tailscale role at deploy time — keep it the only spelling of `tailscale up`.
#
# TS_CLIENT_ID / TS_CLIENT_SECRET come from /etc/tailscale/autoauth.env under
# systemd, and from the task environment when Ansible calls it.
set -euo pipefail

# Wait for tailscaled's socket to be answerable before deciding anything.
for _ in $(seq 1 30); do
    if tailscale status --json >/dev/null 2>&1; then
        break
    fi
    sleep 2
done

# Whitespace-tolerant: `tailscale status --json` pretty-prints with a space
# after the colon, so an unspaced pattern never matches.
if tailscale status --json | grep -Eq '"BackendState"[[:space:]]*:[[:space:]]*"Running"'; then
    echo "Tailscale already Running; nothing to do."
    exit 0
fi

echo "Tailscale not Running; re-authenticating with OAuth client."
args=(
    --client-id="${TS_CLIENT_ID}"
    --client-secret="${TS_CLIENT_SECRET}"
    --hostname="{{ inventory_hostname | regex_replace('[^a-zA-Z0-9-]', '-') }}"
    --advertise-tags="tag:ci"
    # Spelled out because it is load-bearing, not because it differs from the
    # default: MagicDNS is what resolves the *.ts.net targets every
    # <svc>.internal.jterrazz.com CNAME points at.
    --accept-dns=true
)
tailscale up "${args[@]}"
