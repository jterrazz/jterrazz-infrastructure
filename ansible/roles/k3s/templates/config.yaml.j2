# Managed by Ansible (roles/k3s).

node-ip: {{ k3s_node_ip }}

# NO `cluster-init`: it forces embedded etcd, which holds the keyspace in RAM
# and runs its own compaction/snapshotting for ~150-300Mi more RSS and zero
# benefit on one node (the cluster is reproducible from deploy.sh+Ansible and app
# data is hostPath). Re-add it only when going multi-node HA.
token: {{ k3s_cluster_token }}

# 0600, not 0644: this file is a cluster-admin credential. The cross-machine
# read via /mnt/machines is closed by the nftables guard in roles/security, not
# by this mode.
write-kubeconfig-mode: "0600"

# Every name a client may use to reach the API server must be here or kubectl
# fails cert verification; the tailnet IP and MagicDNS name are how the laptop
# and CI reach it. `ansible_host` is deliberately NOT a SAN — it is `orb`, an
# OrbStack SSH-config alias no client can ever present.
tls-san:
  - {{ k3s_node_ip }}
  - localhost
  - 127.0.0.1
{% if tailscale_ip | default('') != '' %}
  - {{ tailscale_ip }}
{% endif %}
{% if tailscale_dns_hostname | default('') != '' %}
  - {{ tailscale_dns_hostname }}
{% endif %}

# resolv-conf MUST be the uplink file with real upstream servers, never
# /etc/resolv.conf (the 127.0.0.53 stub on systemd-resolved hosts). With the
# stub, kubelet hands it to pods inheriting host DNS — CoreDNS runs
# dnsPolicy: Default — so CoreDNS forwards into itself and its loop plugin
# fatals on startup.
kubelet-arg:
  - "max-pods=250"
  - "resolv-conf=/run/systemd/resolve/resolv.conf"

kube-apiserver-arg:
  - "enable-admission-plugins=NodeRestriction,ResourceQuota"
  # Audit trail for "who changed what". k3s writes no audit log by default, so
  # a compromised token leaves no record at all. metadata level only: it logs
  # request metadata, never request/response bodies, which is what keeps
  # Secret contents out of the log file.
  - "audit-log-path={{ k3s_data_dir }}/server/logs/audit.log"
  - "audit-log-maxage=30"
  - "audit-log-maxbackup=3"
  - "audit-log-maxsize=64"
  - "audit-policy-file=/etc/rancher/k3s/audit-policy.yaml"

# Encrypts Secrets in the datastore with AES-CBC. WITHOUT this, every Secret
# sits in plaintext in state.db, and that file is readable by any other
# OrbStack machine through /mnt/machines/<name>/, which is not an isolation
# boundary.
#
# Verify by value, never by `strings | grep -c password`: that count is
# dominated by CRD schemas and ConfigMaps, which are not encrypted by design
# and never were secrets. The real check is
#   kubectl get secret <n> -o jsonpath='{.data.*}' | base64 -d
#   grep -a "<that value>" state.db     # must find nothing
#
# Enabling only encrypts secrets written AFTER the restart. Existing ones stay
# plaintext until `k3s secrets-encrypt reencrypt --force` rewrites them, which
# roles/k3s/tasks does once the API is back.
secrets-encryption: true

# local-storage is k3s' local-path-provisioner. Every PVC here uses the
# `manual` StorageClass with a pre-declared hostPath PV (the service and app
# charts emit both), so the provisioner has nothing to provision.
#
# Disabling it is a SAFETY fix as much as a memory one: local-path ships as
# the cluster DEFAULT StorageClass with reclaimPolicy `Delete`, so a PVC that
# ever omits `storageClassName` lands on ephemeral node storage and its data
# is deleted when the claim goes away — silently, and only for the one
# service that forgot the field. With no default class, that same PVC stays
# Pending, which is a loud, harmless failure instead.
disable:
  - local-storage
