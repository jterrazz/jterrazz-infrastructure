---
# Callers MUST pass `-c ansible/.ansible-lint`: config auto-discovery searches
# the CWD and walks UP, never down into the linted directory, so running from
# the repo root without it silently reverts profile, skips and excludes to
# defaults.
#
# `production` is the strictest built-in tier. If a rule becomes genuinely
# wrong for this setup, skip it below WITH A REASON rather than dropping the
# profile.
profile: production

exclude_paths:
  - .github/
  - kubernetes/

skip_list:
  # This repo drives one node imperatively (helm/kubectl on the host); many
  # steps have no module equivalent and express idempotency via changed_when.
  - command-instead-of-shell # `shell` is used where set -o pipefail / loops are needed
  - no-changed-when # explicitly handled everywhere it matters; the rest are probes
  - yaml[line-length] # long single-line helm invocations beat folded YAML here
  # Guards against third-party roles colliding in the shared play namespace,
  # which cannot happen with five first-party roles on one host. `kubeconfig`
  # and `manifest_dir` are unprefixed deliberately: platform.yml's post_tasks
  # read them, and they describe the node rather than a role.
  - var-naming[no-role-prefix]

warn_list:
  - experimental
