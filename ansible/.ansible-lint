---
# hazard: callers MUST pass `-c ansible/.ansible-lint`: discovery walks UP from the CWD,
# so without it profile, skips and excludes silently revert to defaults.
profile: production

exclude_paths:
  - .github/
  - kubernetes/

skip_list:
  # This repo drives one node imperatively (helm/kubectl on the host); many
  # steps have no module equivalent and express idempotency via changed_when.
  - command-instead-of-shell # `shell` is used where set -o pipefail / loops are needed
  - no-changed-when # explicitly handled everywhere it matters; the rest are probes
  - yaml[line-length] # long single-line helm invocations beat folded YAML here
  # invariant: five first-party roles cannot collide; `kubeconfig` and `manifest_dir`
  # describe the node and are read by platform.yml.
  - var-naming[no-role-prefix]

warn_list:
  - experimental
