---
# hazard: callers MUST pass `-c ansible/.ansible-lint`: discovery walks up from the CWD and
# silently falls back to the defaults.
profile: production

exclude_paths:
  - .github/
  - kubernetes/

skip_list:
  # value: one node driven imperatively (helm/kubectl on the host): `shell` where pipefail or
  # loops are needed, `changed_when` where it matters, long helm lines unfolded.
  - command-instead-of-shell
  - no-changed-when
  - yaml[line-length]
  # invariant: `kubeconfig` and `manifest_dir` describe the node and platform.yml reads them.
  - var-naming[no-role-prefix]

warn_list:
  - experimental
