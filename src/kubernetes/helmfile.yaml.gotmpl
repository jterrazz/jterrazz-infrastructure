# invariant: every platform release, declared once; paths are relative, since the node receives
# only src/kubernetes/. hazard: a release's name and namespace are the identity of live data:
# renaming either orphans the hostPath PV it bound (ADR-009).

repositories:
  - name: jetstack
    url: https://charts.jetstack.io
  - name: infisical
    url: https://dl.cloudsmith.io/public/infisical/helm-charts/helm/charts/
  - name: grafana-community
    url: https://grafana-community.github.io/helm-charts
  - name: vm
    url: https://victoriametrics.github.io/helm-charts/
  - name: prometheus-community
    url: https://prometheus-community.github.io/helm-charts
  - name: open-telemetry
    url: https://open-telemetry.github.io/opentelemetry-helm-charts

helmDefaults:
  # invariant: false only in the upgrade test, which judges with `helm list --failed` (ADR-021).
  wait: {{ env "PLATFORM_HELM_WAIT" | default "true" }}
  timeout: 300
  # hazard: helm would create a namespace without its Pod Security labels.
  createNamespace: false
  # value: 3 release revisions, not helm's 10: each is a Secret in k3s' SQLite.
  historyMax: 3

templates:
  platform-service:
    chart: ./charts/platform-service
    timeout: 120
    needs:
      - platform-networking/cert-manager
    labels:
      pass: claims
    values:
      # invariant: the PV's nodeAffinity target, supplied by the caller.
      - infrastructure:
          nodeName: {{ requiredEnv "NODE_NAME" | quote }}

releases:
  # invariant: the cluster's own objects, first: every namespace the releases below install into,
  # their baselines, RBAC, the admission policies and Traefik's shared objects. A release, so a
  # file removed is an object removed (ADR-009).
  - name: cluster
    namespace: kube-system
    chart: ./charts/cluster
    labels:
      pass: cluster

  # invariant: `pass: operators` goes first: later passes need its CRDs (ADR-009).
  - name: cert-manager
    namespace: platform-networking
    chart: jetstack/cert-manager
    version: v1.21.3
    wait: true
    needs:
      - kube-system/cluster
    labels:
      pass: operators
    values:
      - services/cert-manager/values.yaml

  - name: infisical
    namespace: platform-secrets
    chart: infisical/secrets-operator
    version: 0.11.15
    wait: true
    needs:
      - kube-system/cluster
    labels:
      pass: operators
    values:
      - services/infisical/values.yaml

  - name: grafana-platform
    namespace: platform-telemetry
    inherit:
      - template: platform-service
    values:
      - services/grafana/service.yaml
      # invariant: the platform's dashboards and alert rules, in the layout every app ships
      # (.infrastructure/{dashboards,alerts}); a file removed is a ConfigMap removed (ADR-025).
      - dashboards:
{{- range $file := readDirEntries "../../.infrastructure/dashboards" }}
          {{ $file.Name | trimSuffix ".json" }}: {{ readFile (printf "../../.infrastructure/dashboards/%s" $file.Name) | toJson }}
{{- end }}
        alerts:
{{- range $file := readDirEntries "../../.infrastructure/alerts" }}
          {{ $file.Name | trimSuffix ".yaml" }}: {{ readFile (printf "../../.infrastructure/alerts/%s" $file.Name) | toJson }}
{{- end }}

  - name: victoria-metrics-platform
    namespace: platform-telemetry
    inherit:
      - template: platform-service
    values:
      - services/victoria-metrics/service.yaml

  - name: victoria-logs-platform
    namespace: platform-telemetry
    inherit:
      - template: platform-service
    values:
      - services/victoria-logs/service.yaml

  - name: victoria-traces-platform
    namespace: platform-telemetry
    inherit:
      - template: platform-service
    values:
      - services/victoria-traces/service.yaml

  - name: victoria-metrics
    namespace: platform-telemetry
    chart: vm/victoria-metrics-single
    version: 0.48.0
    needs:
      - platform-telemetry/victoria-metrics-platform
    values:
      - services/victoria-metrics/values.yaml

  - name: victoria-logs
    namespace: platform-telemetry
    chart: vm/victoria-logs-single
    version: 0.13.10
    needs:
      - platform-telemetry/victoria-logs-platform
    values:
      - services/victoria-logs/values.yaml

  # hazard: pre-1.0 knowingly; never a licence for the 1.x stores (ADR-005).
  - name: victoria-traces
    namespace: platform-telemetry
    chart: vm/victoria-traces-single
    version: 0.1.11
    needs:
      - platform-telemetry/victoria-traces-platform
    values:
      - services/victoria-traces/values.yaml

  - name: kube-state-metrics
    namespace: platform-telemetry
    chart: prometheus-community/kube-state-metrics
    version: 8.7.1
    values:
      - services/kube-state-metrics/values.yaml

  - name: node-exporter
    namespace: platform-telemetry
    chart: prometheus-community/prometheus-node-exporter
    version: 4.60.1
    values:
      - services/node-exporter/values.yaml

  - name: otel-collector-platform
    namespace: platform-telemetry
    inherit:
      - template: platform-service
    values:
      - services/otel-collector/service.yaml

  - name: otel-collector
    namespace: platform-telemetry
    chart: open-telemetry/opentelemetry-collector
    version: 0.177.0
    needs:
      - platform-telemetry/otel-collector-platform
      - platform-telemetry/victoria-logs
      - platform-telemetry/victoria-metrics
      - platform-telemetry/victoria-traces
    values:
      - services/otel-collector/values.yaml

  # hazard: grafana.db migrates on first boot, irreversibly; rollback is a data restore.
  - name: grafana
    namespace: platform-telemetry
    chart: grafana-community/grafana
    version: 14.0.1
    needs:
      - platform-telemetry/grafana-platform
    values:
      - services/grafana/values.yaml
      # hazard: inline, never `--set`, which `ps` would show.
      - adminPassword: {{ requiredEnv "GRAFANA_ADMIN_PASSWORD" | quote }}

  - name: traefik-platform
    namespace: kube-system
    inherit:
      - template: platform-service
    values:
      - services/traefik/service.yaml

  - name: cloudflared-platform
    namespace: platform-networking
    inherit:
      - template: platform-service
    values:
      - services/cloudflared/service.yaml

  - name: cloudflared
    namespace: platform-networking
    chart: ./charts/app
    needs:
      - platform-networking/cloudflared-platform
    values:
      - services/cloudflared/app.yaml

  # invariant: OpenPanel is six app-chart releases; openpanel-platform owns their storage and
  # certificates (ADR-010).
  - name: openpanel-platform
    namespace: platform-analytics
    inherit:
      - template: platform-service
    values:
      - services/openpanel/service.yaml

  - name: op-postgres
    namespace: platform-analytics
    chart: ./charts/app
    needs:
      - platform-analytics/openpanel-platform
    values:
      - services/openpanel/op-postgres.yaml

  - name: op-redis
    namespace: platform-analytics
    chart: ./charts/app
    needs:
      - platform-analytics/openpanel-platform
    values:
      - services/openpanel/op-redis.yaml

  - name: op-clickhouse
    namespace: platform-analytics
    chart: ./charts/app
    needs:
      - platform-analytics/openpanel-platform
    values:
      - services/openpanel/op-clickhouse.yaml

  # value: 10m, not 5m: a first-boot migration is slow.
  - name: op-api
    namespace: platform-analytics
    chart: ./charts/app
    timeout: 600
    needs:
      - platform-analytics/op-postgres
      - platform-analytics/op-redis
      - platform-analytics/op-clickhouse
    values:
      - services/openpanel/_common.yaml
      - services/openpanel/op-api.yaml

  - name: op-worker
    namespace: platform-analytics
    chart: ./charts/app
    needs:
      - platform-analytics/op-api
    values:
      - services/openpanel/_common.yaml
      - services/openpanel/op-worker.yaml

  - name: op-dashboard
    namespace: platform-analytics
    chart: ./charts/app
    needs:
      - platform-analytics/op-api
    values:
      - services/openpanel/_common.yaml
      - services/openpanel/op-dashboard.yaml

  - name: registry-platform
    namespace: platform-registry
    inherit:
      - template: platform-service
    values:
      - services/registry/service.yaml

  - name: registry
    namespace: platform-registry
    chart: ./charts/app
    needs:
      - platform-registry/registry-platform
    values:
      - services/registry/app.yaml
