      managedKubeSecretReferences:
        - secretName: registry-credentials
          secretNamespace: NAMESPACE
          secretType: kubernetes.io/dockerconfigjson
          template:
            data:
              .dockerconfigjson: '{{ dict "auths" (dict "registry.internal.jterrazz.com" (dict "username" .REGISTRY_PULL_USERNAME.Value "password" .REGISTRY_PULL_PASSWORD.Value "auth" (list .REGISTRY_PULL_USERNAME.Value .REGISTRY_PULL_PASSWORD.Value | join ":" | b64enc))) | toJson }}'
      syncConfig:
        resyncInterval: 5m
