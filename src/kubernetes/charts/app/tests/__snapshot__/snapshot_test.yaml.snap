  4: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      annotations:
        app.jterrazz.com/repository: jterrazz/ci-test-app
        secrets.infisical.com/auto-reload: "true"
      labels:
        app: ci-test-app
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: ci-test-app
        environment: prod
      name: ci-test-app
    spec:
      replicas: 1
      revisionHistoryLimit: 3
      selector:
        matchLabels:
          app: ci-test-app
          environment: prod
      strategy:
        type: Recreate
      template:
        metadata:
          annotations:
            checksum/config: b3983c4ad012e8409ac26322266e0ae97c7b09732a5ef969b9175c18a899bf55
          labels:
            app: ci-test-app
            environment: prod
            platform-client.jterrazz.com/jterrazz-intelligence: "true"
        spec:
          automountServiceAccountToken: false
          containers:
            - args:
                - --enable-source-maps
              command:
                - node
                - server.js
              env:
                - name: PORT
                  value: "3000"
                - name: LOG_LEVEL
                  value: info
                - name: OTEL_SERVICE_NAME
                  value: ci-test-app
                - name: OTEL_RESOURCE_ATTRIBUTES
                  value: deployment.environment=prod,deployment.environment.name=prod
                - name: JTERRAZZ_INTELLIGENCE_BASE_URL
                  value: http://jterrazz-intelligence.jterrazz-intelligence-prod.svc.cluster.local/v1
                - name: OTEL_EXPORTER_OTLP_ENDPOINT
                  value: http://otel-collector.platform-telemetry:4318
                - name: NODE_OPTIONS
                  value: --max-old-space-size=384
                - name: DATABASE_URL
                  valueFrom:
                    secretKeyRef:
                      key: DATABASE_URL
                      name: ci-test-app-secrets
                - name: API_TOKEN
                  valueFrom:
                    secretKeyRef:
                      key: API_TOKEN
                      name: ci-test-app-secrets
              image: registry.internal.jterrazz.com/ci-test-app:ci
              livenessProbe:
                httpGet:
                  path: /healthz
                  port: 3000
                timeoutSeconds: 5
              name: ci-test-app
              ports:
                - containerPort: 3000
              readinessProbe:
                httpGet:
                  path: /health
                  port: 3000
                timeoutSeconds: 5
              resources:
                limits:
                  memory: 1Gi
                requests:
                  cpu: 100m
                  memory: 512Mi
              securityContext:
                allowPrivilegeEscalation: false
                capabilities:
                  add:
                    - NET_BIND_SERVICE
                  drop:
                    - ALL
                runAsNonRoot: true
                seccompProfile:
                  type: RuntimeDefault
              startupProbe:
                failureThreshold: 30
                httpGet:
                  path: /healthz
                  port: 3000
                timeoutSeconds: 5
              volumeMounts:
                - mountPath: /data
                  name: data
                - mountPath: /app/ci-test.json
                  name: config
                  readOnly: true
                  subPath: ci-test.json
                - mountPath: /etc/ci-test/conf.d/ci-test.xml
                  name: config
                  readOnly: true
                  subPath: ci-test.xml
                - mountPath: /etc/ci-test-files
                  name: ci-test-app-files
                  readOnly: true
          imagePullSecrets:
            - name: registry-credentials
          securityContext:
            fsGroup: 1000
            runAsGroup: 1000
            runAsUser: 1000
          volumes:
            - name: data
              persistentVolumeClaim:
                claimName: ci-test-app-data
            - configMap:
                name: ci-test-app-config
              name: config
            - name: ci-test-app-files
              secret:
                secretName: ci-test-app-files
