  35: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: platform-reader
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: platform-reader
    subjects:
      - apiGroup: rbac.authorization.k8s.io
        kind: User
        name: github:jterrazz/studio-infrastructure
  36: |
    apiVersion: storage.k8s.io/v1
    kind: StorageClass
    metadata:
      name: manual
    provisioner: kubernetes.io/no-provisioner
    reclaimPolicy: Retain
    volumeBindingMode: WaitForFirstConsumer
  37: |
    apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      labels:
        app.kubernetes.io/component: rate-limit
        app.kubernetes.io/name: traefik
      name: rate-limit
      namespace: platform-networking
    spec:
      rateLimit:
        average: 100
        burst: 200
        sourceCriterion:
          requestHeaderName: Cf-Connecting-Ip
  38: |
    apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      labels:
        app.kubernetes.io/name: traefik
      name: compress
      namespace: platform-networking
    spec:
      compress:
        includedContentTypes:
          - text/html
          - text/css
          - text/plain
          - text/javascript
          - application/javascript
          - application/json
          - application/xml
          - image/svg+xml
  39: |
    apiVersion: traefik.io/v1alpha1
    kind: Middleware
    metadata:
      labels:
        app.kubernetes.io/name: traefik
      name: security-headers
      namespace: platform-networking
    spec:
      headers:
        contentTypeNosniff: true
        customResponseHeaders:
          Server: ""
          X-Powered-By: ""
        frameDeny: true
        referrerPolicy: strict-origin-when-cross-origin
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 31536000
  40: |
    apiVersion: traefik.io/v1alpha1
    kind: TLSOption
    metadata:
      name: default
      namespace: kube-system
    spec:
      minVersion: VersionTLS13
  41: |
    apiVersion: traefik.io/v1alpha1
    kind: TLSStore
    metadata:
      name: default
      namespace: kube-system
    spec:
      certificates:
        - secretName: wildcard-internal-tls
        - secretName: wildcard-staging-tls
      defaultCertificate:
        secretName: wildcard-internal-tls
