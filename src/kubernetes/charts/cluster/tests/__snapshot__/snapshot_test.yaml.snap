  25: |
    apiVersion: networking.k8s.io/v1
    kind: NetworkPolicy
    metadata:
      name: allow-traefik-ingress
      namespace: kube-system
    spec:
      ingress:
        - from:
            - podSelector:
                matchLabels:
                  svccontroller.k3s.cattle.io/svcname: traefik
            - ipBlock:
                cidr: 0.0.0.0/0
                except:
                  - 10.42.0.0/16
          ports:
            - port: 8000
              protocol: TCP
            - port: 8443
              protocol: TCP
            - port: 8443
              protocol: UDP
        - from:
            - namespaceSelector:
                matchLabels:
                  kubernetes.io/metadata.name: platform-networking
              podSelector:
                matchLabels:
                  app.kubernetes.io/name: cloudflared
          ports:
            - port: 8090
              protocol: TCP
      podSelector:
        matchLabels:
          app.kubernetes.io/name: traefik
      policyTypes:
        - Ingress
  26: |
