matches the recorded render:
  1: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      name: app-deployer-ownership
    spec:
      failurePolicy: Fail
      matchConditions:
        - expression: request.userInfo.username.startsWith('github:')
          name: github-actions-identity
      matchConstraints:
        resourceRules:
          - apiGroups:
              - '*'
            apiVersions:
              - '*'
            operations:
              - CREATE
              - UPDATE
              - DELETE
            resources:
              - '*/*'
            scope: '*'
      validations:
        - expression: variables.owned || variables.namespaceOwner == variables.repo
          messageExpression: '''namespace '' + request.namespace + '' is not owned by '' + variables.repo'
        - expression: '!variables.owned || (request.operation == ''CREATE'' ? variables.newOwner == variables.repo : request.operation == ''DELETE'' ? variables.oldOwner == variables.repo : variables.oldOwner == variables.repo && variables.newOwner == variables.repo)'
          messageExpression: request.resource.resource + ' ' + request.name + ' must carry ' + variables.key + '=' + variables.repo
        - expression: '!variables.isNamespace || object == null || !has(object.metadata.labels) || object.metadata.labels.all(k, !(k.startsWith(''pod-security.kubernetes.io/'') && object.metadata.labels[k] == ''privileged''))'
          message: a namespace created by an app may not opt out of Pod Security
        - expression: |-
            !variables.isNamespace || object == null || (
              has(object.metadata.labels) && 'studio.jterrazz.com/app' in object.metadata.labels && (
                object.metadata.labels['studio.jterrazz.com/app'] == variables.repo ||
                (variables.repo in variables.repositoryApps &&
                 object.metadata.labels['studio.jterrazz.com/app'] in variables.repositoryApps[variables.repo])
              )
            )
          messageExpression: '''an app namespace states an app named '' + variables.repo + '', or one the policy pairs with it'''
        - expression: |-
            !variables.isNamespace || object == null || (
              has(object.metadata.labels) && 'studio.jterrazz.com/app' in object.metadata.labels && (
                'studio.jterrazz.com/scope' in object.metadata.labels
                  ? object.metadata.labels['studio.jterrazz.com/scope'] == 'shared' &&
                    !('studio.jterrazz.com/environment' in object.metadata.labels) &&
                    object.metadata.name == object.metadata.labels['studio.jterrazz.com/app']
                  : 'studio.jterrazz.com/environment' in object.metadata.labels &&
                    object.metadata.name == object.metadata.labels['studio.jterrazz.com/app'] + '-' + object.metadata.labels['studio.jterrazz.com/environment']
              )
            )
          message: an app namespace is <app>-<environment>, or <app> when shared, as its studio.jterrazz.com/ labels state
        - expression: '!variables.isVolume || object == null || (object.metadata.name.endsWith(''-data'') && has(object.spec.hostPath) && object.spec.hostPath.path == ''/var/lib/k8s-data/'' + object.metadata.name.substring(0, size(object.metadata.name) - 5))'
          message: an app volume is a hostPath at /var/lib/k8s-data/<name minus -data>
        - expression: |-
            !variables.isInfisicalSecret || object == null || (
              object.spec.hostAPI == 'https://eu.infisical.com' &&
              object.spec.authentication.all(method, method == 'universalAuth') &&
              object.spec.authentication.universalAuth.credentialsRef.secretNamespace == 'platform-secrets' &&
              object.spec.authentication.universalAuth.credentialsRef.secretName == 'infisical-credentials' &&
              !has(object.spec.managedSecretReference) &&
              has(object.spec.managedKubeSecretReferences) &&
              object.spec.managedKubeSecretReferences.all(r, r.secretNamespace == request.namespace) &&
              (
                (object.spec.authentication.universalAuth.secretsScope.projectSlug == 'studio-infrastructure' &&
                 variables.appIsTheRepository &&
                 object.spec.authentication.universalAuth.secretsScope.secretsPath == '/' + variables.app &&
                 variables.secretsEnv != '' &&
                 object.spec.authentication.universalAuth.secretsScope.envSlug == variables.secretsEnv) ||
                (object.spec.authentication.universalAuth.secretsScope.projectSlug == variables.registryProject &&
                 object.spec.authentication.universalAuth.secretsScope.secretsPath == '/' &&
                 object.spec.managedKubeSecretReferences.all(r, has(r.template) && r.template.data == {'.dockerconfigjson': variables.registryTemplate}))
              )
            )
          messageExpression: '''an app InfisicalSecret reads /'' + variables.app + '' in env '' + variables.secretsEnv + '', or the registry pull pair, into its own namespace'''
        - expression: '!(request.resource.group == ''rbac.authorization.k8s.io'' && request.resource.resource == ''rolebindings'') || object == null || (object.roleRef.kind == ''ClusterRole'' && object.roleRef.name == ''app-namespace-admin'' && has(object.subjects) && object.subjects.all(s, s.kind == ''User'' && s.name == request.userInfo.username))'
          message: an app RoleBinding binds app-namespace-admin to its own identity only
      variables:
        - expression: request.userInfo.username.substring(request.userInfo.username.indexOf('/') + 1)
          name: repo
        - expression: '''studio.jterrazz.com/repository'''
          name: key
        - expression: '{''studio-os'': [''studio-console'']}'
          name: repositoryApps
        - expression: 'object == null || !has(object.metadata.labels) || !(variables.key in object.metadata.labels) ? '''' : object.metadata.labels[variables.key]'
          name: newOwner
        - expression: 'oldObject == null || !has(oldObject.metadata.labels) || !(variables.key in oldObject.metadata.labels) ? '''' : oldObject.metadata.labels[variables.key]'
          name: oldOwner
        - expression: 'namespaceObject == null || !has(namespaceObject.metadata.labels) || !(variables.key in namespaceObject.metadata.labels) ? '''' : namespaceObject.metadata.labels[variables.key]'
          name: namespaceOwner
        - expression: request.resource.group == '' && request.resource.resource == 'namespaces'
          name: isNamespace
        - expression: request.resource.group == '' && request.resource.resource == 'persistentvolumes'
          name: isVolume
        - expression: variables.isNamespace || variables.isVolume
          name: owned
        - expression: request.resource.group == 'secrets.infisical.com' && request.resource.resource == 'infisicalsecrets'
          name: isInfisicalSecret
        - expression: 'namespaceObject == null || !has(namespaceObject.metadata.labels) || !(''studio.jterrazz.com/app'' in namespaceObject.metadata.labels) ? '''' : namespaceObject.metadata.labels[''studio.jterrazz.com/app'']'
          name: app
        - expression: variables.app != '' && (variables.app == variables.repo || (variables.repo in variables.repositoryApps && variables.app in variables.repositoryApps[variables.repo]))
          name: appIsTheRepository
        - expression: 'namespaceObject == null || !has(namespaceObject.metadata.labels) ? '''' : ''studio.jterrazz.com/scope'' in namespaceObject.metadata.labels && namespaceObject.metadata.labels[''studio.jterrazz.com/scope''] == ''shared'' ? ''prod'' : !(''studio.jterrazz.com/environment'' in namespaceObject.metadata.labels) ? '''' : namespaceObject.metadata.labels[''studio.jterrazz.com/environment'']'
          name: secretsEnv
        - expression: '''studio-ci'''
          name: registryProject
        - expression: '''{{ dict "auths" (dict "registry.internal.jterrazz.com" (dict "username" .REGISTRY_PULL_USERNAME.Value "password" .REGISTRY_PULL_PASSWORD.Value "auth" (list .REGISTRY_PULL_USERNAME.Value .REGISTRY_PULL_PASSWORD.Value | join ":" | b64enc))) | toJson }}'''
          name: registryTemplate
  2: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      name: app-deployer-ownership
    spec:
      policyName: app-deployer-ownership
      validationActions:
        - Deny
  3: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicy
    metadata:
      name: host-access
    spec:
      failurePolicy: Fail
      matchConstraints:
        resourceRules:
          - apiGroups:
              - ""
            apiVersions:
              - v1
            operations:
              - CREATE
              - UPDATE
            resources:
              - pods
            scope: '*'
      validations:
        - expression: '!variables.touchesHost || variables.allowed'
          messageExpression: '''pod '' + object.metadata.?name.orValue(object.metadata.?generateName.orValue('''')) + '' asks for host access, which only node-exporter and otel-collector in platform-telemetry may have'''
      variables:
        - expression: object.spec.containers + object.spec.?initContainers.orValue([]) + object.spec.?ephemeralContainers.orValue([])
          name: containers
        - expression: object.spec.?hostNetwork.orValue(false) || object.spec.?hostPID.orValue(false) || object.spec.?hostIPC.orValue(false) || object.spec.?volumes.orValue([]).exists(v, has(v.hostPath)) || variables.containers.exists(c, c.?securityContext.?privileged.orValue(false))
          name: touchesHost
        - expression: |-
            namespaceObject.metadata.name == 'kube-system' || (namespaceObject.metadata.name == 'platform-telemetry' &&
             object.spec.?serviceAccountName.orValue('default') in ['node-exporter', 'otel-collector'])
          name: allowed
  4: |
    apiVersion: admissionregistration.k8s.io/v1
    kind: ValidatingAdmissionPolicyBinding
    metadata:
      name: host-access
    spec:
      policyName: host-access
      validationActions:
        - Deny
