apiVersion: v1
kind: ConfigMap
metadata:
  name: coredns-custom
  namespace: kube-system
data:
  private-hosts.server: |
    {{ dns_zone }}:53 {
      errors
      cache 30
      template IN A {{ dns_zone }} {
        match "{{ coredns_private_zones_regexp }}"
        answer "{% raw %}{{ .Name }}{% endraw %} 60 IN A {{ tailscale_ip }}"
        fallthrough
      }
      template IN AAAA {{ dns_zone }} {
        match "{{ coredns_private_zones_regexp }}"
        rcode NOERROR
        fallthrough
      }
      forward . 1.1.1.1 9.9.9.9
    }
