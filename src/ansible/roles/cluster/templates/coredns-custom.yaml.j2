apiVersion: v1
kind: ConfigMap
metadata:
  name: coredns-custom
  namespace: kube-system
data:
  private-hosts.server: |
    jterrazz.com:53 {
      template IN A jterrazz.com {
        match "{{ coredns_private_zones_regexp }}"
        answer "{% raw %}{{ .Name }}{% endraw %} 60 IN A {{ tailscale_ip }}"
        fallthrough
      }
      template IN AAAA jterrazz.com {
        match "{{ coredns_private_zones_regexp }}"
        rcode NOERROR
        fallthrough
      }
      forward . 1.1.1.1 9.9.9.9
    }
