# Managed by Ansible (security role); do not edit manually.
#
# A DROP-IN loaded by `Include /etc/ssh/sshd_config.d/*.conf` at the TOP of
# Debian's stock sshd_config. Keywords here win only because of that position:
# in sshd_config the first occurrence of a keyword takes effect.

AddressFamily inet
ListenAddress 0.0.0.0

# invariant: no Ciphers, MACs or KexAlgorithms: OpenSSH 10's defaults are stronger than any list
# pinned here, the post-quantum mlkem768x25519 exchange included.

PermitRootLogin {{ security_ssh_permit_root_login }}
PasswordAuthentication {{ security_ssh_password_authentication }}
# ChallengeResponseAuthentication is the pre-8.7 spelling; current sshd warns
# on the deprecated alias.
KbdInteractiveAuthentication no
GSSAPIAuthentication no
UsePAM yes

MaxAuthTries {{ security_ssh_max_auth_tries }}
# value: 10, the default: CI's host specs open one session per spec file in parallel.
MaxSessions 10
MaxStartups 3:50:10

ClientAliveInterval {{ security_ssh_client_alive_interval }}
ClientAliveCountMax {{ security_ssh_client_alive_count_max }}
LoginGraceTime 30

X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
PermitTunnel no
PermitEmptyPasswords no
PermitUserEnvironment no

SyslogFacility AUTH
LogLevel VERBOSE
