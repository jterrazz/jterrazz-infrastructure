#!/usr/bin/env bash
# invariant: managed by Ansible (tailscale role); the only spelling of `tailscale up`,
# run at boot (autoauth.env) and at deploy (task environment).
set -euo pipefail

for _ in $(seq 1 30); do
    if tailscale status --json >/dev/null 2>&1; then
        break
    fi
    sleep 2
done

# outside: whitespace-tolerant: the JSON is pretty-printed.
if tailscale status --json | grep -Eq '"BackendState"[[:space:]]*:[[:space:]]*"Running"'; then
    echo "Tailscale already Running; nothing to do."
    exit 0
fi

echo "Tailscale not Running; re-authenticating with OAuth client."
args=(
    --client-id="${TS_CLIENT_ID}"
    --client-secret="${TS_CLIENT_SECRET}"
    --hostname="{{ inventory_hostname | regex_replace('[^a-zA-Z0-9-]', '-') }}"
    # invariant: the role the tailnet policy grants: admins reach it, CI on 22/443/6443,
    # it initiates nothing. The OAuth client may mint this tag alone.
    --advertise-tags="tag:cluster"
    # invariant: the default, spelled out: MagicDNS resolves every *.internal target.
    --accept-dns=true
    # hazard: not the default: since 1.102 the SNAT hides the 100.x source from
    # Traefik's loadBalancerSourceRanges, killing every private hostname.
    --snat-subnet-routes=false
)
tailscale up "${args[@]}"
