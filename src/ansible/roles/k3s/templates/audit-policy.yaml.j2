# Managed by Ansible (roles/k3s).
#
# Metadata level everywhere, never RequestResponse: bodies would put Secret
# and ConfigMap contents in a plaintext file on disk, which is the opposite of
# what the encryption-at-rest setting next to it is for.
#
# The `None` rules are the difference between a useful log and a full disk. A
# one-node cluster's controllers generate a continuous stream of reads and
# leases; none of it is evidence of anything, and on this host the log shares
# the volume with the datastore.
apiVersion: audit.k8s.io/v1
kind: Policy
omitStages:
  - RequestReceived
rules:
  # invariant: FIRST, so no rule below can silence it: every get or list of a Secret,
  # by anyone, a controller or the local admin included. A `watch` is the kubelet
  # and the operators keeping mounted Secrets fresh, all day, and is no evidence.
  - level: Metadata
    verbs: ["get", "list"]
    resources:
      - group: ""
        resources: ["secrets"]

  # Kubernetes events are the cluster narrating itself.
  - level: None
    resources:
      - group: ""
        resources: ["events"]
      - group: events.k8s.io
        resources: ["events"]

  # Controller chatter: leader-election leases rewrite every couple of seconds.
  - level: None
    resources:
      - group: coordination.k8s.io
        resources: ["leases"]

  # Health and discovery endpoints, hit by every probe and every client.
  - level: None
    nonResourceURLs:
      - /healthz*
      - /livez*
      - /readyz*
      - /version
      - /openapi/*
      - /api*

  # Reads by the cluster's own components. A human or a token doing the same
  # read still lands in the log; this only silences the control plane watching
  # itself.
  - level: None
    users:
      - system:apiserver
      - system:kube-scheduler
      - system:kube-controller-manager
      - system:kube-proxy
      - k3s-cloud-controller-manager
      - system:k3s-supervisor
      - system:k3s-controller
    verbs: ["get", "list", "watch"]
  - level: None
    userGroups: ["system:nodes", "system:serviceaccounts"]
    verbs: ["get", "list", "watch"]
  # value: k3s' own supervisor and helm-controller read as system:admin all day; a read
  # is no evidence, and its writes still land below. These two groups were 80%
  # of the log, which then held a day and a half instead of 30 days.
  - level: None
    users: ["system:admin"]
    verbs: ["get", "list", "watch"]

  # value: the operator rewrites each InfisicalSecret's status on every resync, 39% of all
  # events; its writes to the Secrets it syncs still land below.
  - level: None
    users: ["system:serviceaccount:platform-secrets:infisical-secre-controller-manager"]
    resources:
      - group: secrets.infisical.com
        resources: ["infisicalsecrets", "infisicalsecrets/status"]

  # Permission questions (the platform suite asks dozens per run) change nothing.
  - level: None
    resources:
      - group: authorization.k8s.io
        resources: ["subjectaccessreviews", "selfsubjectaccessreviews", "selfsubjectrulesreviews"]

  # Everything else: every write, and every read of a Secret by anyone.
  - level: Metadata
