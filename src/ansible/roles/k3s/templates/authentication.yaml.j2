# Managed by Ansible (roles/k3s).
#
# invariant: GitHub Actions' OIDC token is a Kubernetes identity. A workflow of
# `jterrazz/<repo>` running on `main` or on a `v*` tag (release-docker deploys
# the `deploy: release` environments from one), asking for audience
# `{{ k3s_oidc_audience }}`, authenticates as user `github:jterrazz/<repo>` in
# group `github-actions:jterrazz`, with no stored credential anywhere: the
# token is minted per job and expires with it. What that identity may do is
# RBAC + the ownership ValidatingAdmissionPolicy in
# kubernetes/charts/cluster/templates/rbac/app-deployers.yaml, not this file.
#
# hazard: the claim rules are the whole trust boundary of the issuer. Without the
# repository_owner rule, ANY public GitHub repository could mint a token this
# apiserver accepts; without the ref rule, any branch of ours could deploy.
# Both refs need write access to the repository to create.
apiVersion: apiserver.config.k8s.io/v1
kind: AuthenticationConfiguration
jwt:
  - issuer:
      url: https://token.actions.githubusercontent.com
      audiences:
        - {{ k3s_oidc_audience }}
    claimValidationRules:
      - expression: "claims.repository_owner == 'jterrazz'"
        message: only repositories of the jterrazz account
      - expression: "claims.ref == 'refs/heads/main' || claims.ref.startsWith('refs/tags/v')"
        message: only workflows running on main or on a v* tag
    claimMappings:
      username:
        expression: "'github:' + claims.repository"
      groups:
        expression: "['github-actions:jterrazz']"
      uid:
        expression: "claims.repository_id"
