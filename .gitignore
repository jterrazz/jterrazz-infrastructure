# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

# Kubeconfig
kubeconfig.yaml

# Helm dependency resolution. `common` is a LIBRARY CHART in this same tree,
# pulled by a relative file:// repository — so `helm dependency update`
# regenerates both of these from source in a second, with no network. Vendoring
# them would mean a second copy of the library that can silently go stale.
kubernetes/charts/*/charts/
kubernetes/charts/*/Chart.lock

# Local data
data/

# Pulumi
pulumi/node_modules/
pulumi/bin/

# Ansible
*.retry
.ansible/

# SSH keys
*.pem
*.key
id_rsa*
id_ed25519*

# Logs
*.log

# Environment
.env
.env.local

# Claude Code (local agent state / settings)
.claude/settings.local.json
.claude/projects/

# Agent worktrees (Claude Code isolation)
.claude/worktrees/
